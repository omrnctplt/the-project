# =============================================================
# On-Premise AI Gateway — ortam degiskenleri
# Kopyala: cp .env.example .env  (Windows: copy .env.example .env)
# =============================================================

# Guvenlik
JWT_SECRET=lutfen-bu-degeri-uzun-rastgele-bir-stringle-degistirin
ADMIN_PASSWORD=admin
GRAFANA_ADMIN_PASSWORD=admin

# Portlar
GATEWAY_PORT=8080
OLLAMA_PORT=11434
PROM_PORT=9090
GRAFANA_PORT=3000

# Zaman dilimi
TZ=Europe/Istanbul
LOG_LEVEL=INFO

# Ollama davranis ayarlari
OLLAMA_KEEP_ALIVE=10m
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=3

# Gateway davranis ayarlari
AUTO_PULL_MODELS=true
IDLE_UNLOAD_MINUTES=10

# Yuk simulatoru (sadece --profile sim ile baslar)
SIM_USERS=10
SIM_DURATION_SEC=120
SIM_DEPT_MIX=hr:0.3,engineering:0.5,general:0.2
SIM_THINK_TIME_SEC=2
