# =============================================================
# On-Premise AI Gateway — ortam degiskenleri
# Kopyala: cp .env.example .env  (Windows: copy .env.example .env)
# =============================================================

# Guvenlik
# JWT_SECRET bos birakilabilir: sistem ilk acilista guvenli bir secret uretip
# data/jwt_secret dosyasinda kalici saklar. Sabit bir deger isterseniz doldurun.
JWT_SECRET=
ADMIN_PASSWORD=admin
GRAFANA_ADMIN_PASSWORD=admin
# Grafana varsayilan localhost-only dinler; LAN'daki BT ekibine acmak icin 0.0.0.0
GRAFANA_BIND=127.0.0.1

# true : demo kullanicilar seed edilir ve login ekraninda listelenir (sunum/test)
# false: yalnizca admin hesabi olusturulur, demo listesi gizlenir (URETIM)
DEMO_MODE=true

# Portlar
GATEWAY_PORT=8888
OLLAMA_PORT=11434
PROM_PORT=9090
GRAFANA_PORT=3000

# Zaman dilimi
TZ=Europe/Istanbul
LOG_LEVEL=INFO

# ----- KAPASITE PROFILI -----
# auto  : Donanima gore otomatik secer (onerilir)
# lite  : Cok dusuk kaynakli makineler — sadece 1 kucuk fallback model
# balanced : Tipik laptop (8-16 GB RAM) — 2-3 kucuk model
# performance : GPU veya >16 GB RAM — kategori basina model
CAPACITY_PROFILE=auto

# Host'un toplam RAM'i (GB). Bos birakirsaniz container otomatik tespit eder
# ama Docker Desktop / WSL2'de bazen yanlis okur. Tipik degerler: 8, 16, 32.
HOST_RAM_GB=

# ----- Docker resource limit'leri -----
# Bilgisayarinizi rahatlatmak icin Docker servislerine ust sinir koyar.
# Gateway hafiftir; Ollama modelleri yukleyecek, ona genis butce verin
# ama HER ZAMAN host RAM'inin yarisindan az tutun.
GATEWAY_MEM_LIMIT=512m
GATEWAY_CPU_LIMIT=1.0
OLLAMA_MEM_LIMIT=6g
OLLAMA_CPU_LIMIT=4.0

# ----- GPU -----
# `make up` GPU'yu otomatik algilar (NVIDIA -> gpu overlay, AMD -> rocm overlay).
# Algilamayi ezmek icin: GPU_MODE=cpu make up  (veya nvidia|amd)
# AMD tuketici kartlari (RX 6xxx/7xxx) ROCm tarafindan resmen desteklenmiyorsa
# asagiya GFX surumu yazin — ornek RX 6700 XT: 10.3.0, RX 7900 XTX: 11.0.0
HSA_OVERRIDE_GFX_VERSION=

# Yarim kalan model indirmelerinin blob kalintilari (`*-partial`) bu yastan
# eskiyse blob-janitor servisi tarafindan otomatik silinir (saat). Taze
# partial'lar korunur: Ollama yeniden pull'da kaldigi yerden devam eder.
STALE_PARTIAL_MAX_AGE_HOURS=24

# ----- Ollama davranis ayarlari -----
# Bos birakin = otomatik: Ollama GPU basina 3 modele kadar es zamanli bellekte
# tutar, gateway kapasite plani butceyle olcekler (~6 GB basina +1, tavan 8).
# Sayi yazarsaniz her iki katmanda da sabitlenir.
OLLAMA_KEEP_ALIVE=3m
OLLAMA_NUM_PARALLEL=
OLLAMA_MAX_LOADED_MODELS=
# KV cache quantization — f16 her donanimda calisir; q8_0 bellek kazandirir
# ama OLLAMA_FLASH_ATTENTION=true gerektirir (yeni Ollama surumlerinde zorunlu).
OLLAMA_KV_CACHE_TYPE=f16
OLLAMA_FLASH_ATTENTION=false

# ----- Gateway davranis -----
# false: modeller ilk istek geldiginde lazy pull edilir (varsayilan)
# true:  bootstrap sonrasi tum aktif modeller arkaplanda indirilir
AUTO_PULL_MODELS=false
IDLE_UNLOAD_MINUTES=3

# ----- KVKK / veri saklama -----
# Denetim (audit) ve kullanim kayitlari bu kadar gun sonra otomatik silinir.
# 0 = otomatik silme kapali. Kurumsal saklama politikaniza gore ayarlayin.
RETENTION_DAYS=180

# ----- Canli kesif -----
DISCOVERY_TTL_HOURS=24
DISCOVERY_HF_LIMIT=40

# ----- Yuk simulatoru (sadece --profile sim ile baslar) -----
SIM_USERS=5
SIM_DURATION_SEC=120
SIM_DEPT_MIX=hr:0.3,engineering:0.5,general:0.2
SIM_THINK_TIME_SEC=2
