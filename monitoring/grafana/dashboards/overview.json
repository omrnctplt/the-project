  "liveNow": false,
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["onprem-ai"],
  "templating": { "list": [] },
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "On-Premise AI Gateway - Genel Bakis",
  "uid": "onprem-ai-overview",
  "version": 1,
  "weekStart": "",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Aktif Istekler",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "onprem-prom" },
      "targets": [
        { "expr": "ai_gateway_inflight_requests", "refId": "A" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area", "colorMode": "value" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 20 }] } } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Aktif Model Sayisi",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "onprem-prom" },
      "targets": [
        { "expr": "ai_gateway_active_models", "refId": "A" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Yuklu Model (Ollama)",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "onprem-prom" },
      "targets": [
        { "expr": "ai_gateway_loaded_models", "refId": "A" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Fallback Orani (1d)",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "onprem-prom" },
      "targets": [
        { "expr": "sum(rate(ai_gateway_fallback_total[1m])) / clamp_min(sum(rate(ai_gateway_requests_total[1m])), 0.001)", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Rate Limit Asilan (5d)",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "onprem-prom" },
      "targets": [
        { "expr": "sum(increase(ai_gateway_rate_limited_total[5m]))", "refId": "A" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Token Cikti / sn",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "onprem-prom" },
      "targets": [
        { "expr": "sum(rate(ai_gateway_tokens_out_total[1m]))", "refId": "A" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Istek Hizi (departman bazinda)",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "onprem-prom" },
      "targets": [
        { "expr": "sum by (department) (rate(ai_gateway_requests_total{status=\"ok\"}[1m]))", "refId": "A", "legendFormat": "{{department}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "p95 Gecikme (model bazinda)",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "onprem-prom" },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, model) (rate(ai_gateway_request_latency_seconds_bucket[5m])))", "refId": "A", "legendFormat": "{{model}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 20,
      "type": "piechart",
      "title": "Model Kullanim Dagilimi (15d)",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "onprem-prom" },
      "targets": [
        { "expr": "sum by (model) (increase(ai_gateway_requests_total[15m]))", "refId": "A", "legendFormat": "{{model}}" }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Hata Orani",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "onprem-prom" },
      "targets": [
        { "expr": "sum(rate(ai_gateway_requests_total{status=\"error\"}[1m]))", "refId": "A", "legendFormat": "hata/sn" },
        { "expr": "sum(rate(ai_gateway_requests_total{status=\"ok\"}[1m]))", "refId": "B", "legendFormat": "ok/sn" }
      ]
    }
  ]
}
